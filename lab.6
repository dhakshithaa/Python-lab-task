#Check if a word ends with "ing" using endswith()

e = input("Enter a word: ")

if e.endswith("ing"):
    print("The word ends with 'ing'.")
else:
    print("The word does not end with 'ing'.")


#Print a string with tabs (\t) and then use expandtabs() to show spaces


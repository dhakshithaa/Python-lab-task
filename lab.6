#Check if a string contains only digits using isdigit()
g= input("Enter a string: ")

if g.isdigit():
    print("The string contains only digits.")
else:
    print("The string does not contain only digits.")

#Check if a string is numeric using isnumeric()

h = input("Enter a string: ")

if h.isnumeric():
    print("The string is numeric.")
else:
    print("The string is not numeric.")

#Check if a string is alphanumeric using isalnum()

i = input("Enter a string: ")

if i.isalnum():
    print("The string is isalnum.")
else:
    print("The string is not isalnum.")

#Check if a string contains only ASCII characters using isascii()

j = input("Enter a string: ")

if j.isascii():
    print("The string contains only ASCII characters.")
else:

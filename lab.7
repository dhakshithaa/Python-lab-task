#Count character frequencies in a string using a dictionary
text = input("Enter a string: ")

frequency = {}

for char in text:
    if char in frequency:
        frequency[char] += 1
    else:
        frequency[char] = 1

print("Character Frequencies:")
for char, count in frequency.items():
    print(char, ":", count)

#Functions:
#Find the length of a string

def find_length(text):
    return len(text)

string = input("Enter a string: ")
print("Length of the string is:", find_length(string))

#Find the maximum value of the number


def find_max(numbers):
    return max(numbers)

numbers = [10, 25, 8, 45, 32]

print("Maximum value is:", find_max(numbers))

#Find the minimum value of the number

def find_min(numbers):
    return min(numbers)

numbers = [10, 25, 8, 45, 32]

print("Minimum value is:", find_min(numbers))

#Find the sum of the number

def find_sum(numbers):
    return sum(numbers)

numbers = [10, 20, 30, 40, 50]

print("Sum of the numbers is:", find_sum(numbers))

#Factorial using recursion function

def factorial(n):
    if n == 0 or n == 1:
        return 1
    return n * factorial(n - 1)

num = int(input("Enter a number: "))

print("Factorial of", num, "is:", factorial(num))


